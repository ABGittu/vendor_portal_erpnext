  "format_data": null,
  "html": "<div class=\"print-format\" style=\"position: relative; overflow: hidden; font-family: sans-serif;\">\n    <!-- Vendor Portal Watermark -->\n    <div style=\"position: absolute; top: 35%; left: 10%; font-size: 72px; color: rgba(156, 163, 175, 0.12); transform: rotate(-30deg); pointer-events: none; z-index: 0; font-weight: 900; letter-spacing: 8px;\">VENDOR PORTAL</div>\n\n    <!-- Vendor Portal Branding Header -->\n    <div style=\"position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #2563eb; padding-bottom: 8px; margin-bottom: 16px;\">\n        <div>\n            <span style=\"font-weight: 800; font-size: 18px; color: #2563eb; letter-spacing: 1px;\">⚡ VENDOR PORTAL</span>\n            <div style=\"font-size: 11px; color: #6b7280;\">Integrated Supplier & Procurement Management</div>\n        </div>\n        <div style=\"text-align: right; font-size: 12px; color: #4b5563;\">\n            <b>{{ _(\"PURCHASE ORDER\") }}</b><br>\n            <span style=\"color: #2563eb; font-weight: bold;\">{{ doc.name }}</span>\n        </div>\n    </div>\n\n    <!-- Company & Supplier Info -->\n    <div style=\"position: relative; z-index: 1; display: flex; justify-content: space-between; margin-bottom: 20px;\">\n        <div style=\"width: 48%;\">\n            <h4 style=\"margin: 0 0 6px 0; color: #1f2937;\">{{ _(\"Vendor Details\") }}</h4>\n            <div style=\"font-size: 13px; line-height: 1.6;\">\n                <b style=\"font-size: 14px;\">{{ doc.supplier_name or doc.supplier }}</b><br>\n                {% set sup = frappe.get_doc(\"Supplier\", doc.supplier) if doc.supplier else None %}\n                {% if sup %}\n                    {% if sup.vendor_category %}\n                        <div style=\"margin: 4px 0;\">\n                            <span style=\"background: #e0e7ff; color: #3730a3; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600;\">{{ sup.vendor_category }}</span>\n                        </div>\n                    {% endif %}\n                    {% if sup.vendor_rating is not none %}\n                        <div>\n                            <b>{{ _(\"Vendor Rating\") }}:</b>\n                            <span style=\"color: #f59e0b; font-size: 15px; font-weight: bold;\">{{ sup.vendor_rating | star_rating }}</span>\n                            <span style=\"color: #4b5563;\">({{ sup.vendor_rating }}/5)</span>\n                        </div>\n                        {% if sup.vendor_rating < 3.0 %}\n                            <div style=\"background-color: #fef2f2; border: 1px solid #f87171; color: #991b1b; padding: 6px 10px; border-radius: 4px; margin-top: 6px; font-size: 11px; font-weight: 600;\">\n                                ⚠️ {{ _(\"Caution: Low-rated vendor\") }}\n                            </div>\n                        {% endif %}\n                    {% endif %}\n                {% endif %}\n            </div>\n        </div>\n        <div style=\"width: 48%; text-align: right;\">\n            <h4 style=\"margin: 0 0 6px 0; color: #1f2937;\">{{ doc.company }}</h4>\n            <div style=\"font-size: 13px; color: #4b5563; line-height: 1.6;\">\n                <b>{{ _(\"Order Date\") }}:</b> {{ doc.transaction_date }}<br>\n                <b>{{ _(\"Required By\") }}:</b> {{ doc.schedule_date or \"-\" }}<br>\n                <b>{{ _(\"Currency\") }}:</b> {{ doc.currency }}\n            </div>\n        </div>\n    </div>\n\n    <!-- Items Table -->\n    <table class=\"table table-bordered\" style=\"position: relative; z-index: 1; width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px;\">\n        <thead>\n            <tr style=\"background-color: #f3f4f6;\">\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: left; width: 5%;\">#</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: left; width: 45%;\">{{ _(\"Item\") }}</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right; width: 15%;\">{{ _(\"Qty\") }}</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right; width: 15%;\">{{ _(\"Rate\") }}</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right; width: 20%;\">{{ _(\"Amount\") }}</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db;\">{{ loop.index }}</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db;\">\n                    <b>{{ item.item_code }}</b><br>\n                    <small style=\"color: #6b7280;\">{{ item.item_name }}</small>\n                </td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ item.qty }} {{ item.uom or \"\" }}</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ frappe.format(item.rate, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ frappe.format(item.amount, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr style=\"background-color: #f9fafb; font-weight: bold;\">\n                <td colspan=\"4\" style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ _(\"Grand Total\") }} ({{ doc.currency }}):</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ frappe.format(doc.grand_total, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}</td>\n            </tr>\n        </tfoot>\n    </table>\n\n    <!-- Vendor Portal Footer Branding -->\n    <div style=\"position: relative; z-index: 1; margin-top: 30px; border-top: 1px dashed #d1d5db; padding-top: 10px; display: flex; justify-content: space-between; font-size: 11px; color: #9ca3af;\">\n        <span>Generated via <b>Vendor Portal</b> Custom App</span>\n        <span>Verified Purchase Order</span>\n    </div>\n</div>",
