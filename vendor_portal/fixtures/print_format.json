  "html": "<div class=\"print-format\">\n    <div style=\"border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px;\">\n        <h2 style=\"margin: 0; color: #1f2937;\">{{ _(\"PURCHASE ORDER\") }}</h2>\n        <div style=\"font-size: 14px; color: #6b7280;\">{{ doc.name }} | {{ doc.transaction_date }}</div>\n    </div>\n\n    <!-- Company & Supplier Info -->\n    <div style=\"display: flex; justify-content: space-between; margin-bottom: 20px;\">\n        <div style=\"width: 48%;\">\n            <h4 style=\"margin: 0 0 5px 0;\">{{ _(\"Vendor Details\") }}</h4>\n            <div style=\"font-size: 13px;\">\n                <b>{{ doc.supplier_name or doc.supplier }}</b><br>\n                {% set sup = frappe.get_doc(\"Supplier\", doc.supplier) if doc.supplier else None %}\n                {% if sup %}\n                    {% if sup.vendor_category %}\n                        <span><b>{{ _(\"Category\") }}:</b> {{ sup.vendor_category }}</span><br>\n                    {% endif %}\n                    {% if sup.vendor_rating is not none %}\n                        <span><b>{{ _(\"Vendor Rating\") }}:</b> <span style=\"color: #f59e0b; font-size: 16px;\">{{ sup.vendor_rating | star_rating }}</span> ({{ sup.vendor_rating }}/5)</span><br>\n                        {% set threshold = frappe.db.get_single_value(\"Vendor Portal Settings\", \"low_rating_threshold\") or 2.5 %}\n                        {% if sup.vendor_rating < threshold %}\n                            <div style=\"background-color: #fef2f2; border: 1px solid #f87171; color: #991b1b; padding: 4px 8px; border-radius: 4px; margin-top: 5px; font-size: 11px;\">\n                                ⚠️ {{ _(\"Note: Vendor performance review pending - rating below threshold ({0}/5).\").format(threshold) }}\n                            </div>\n                        {% endif %}\n                    {% endif %}\n                {% endif %}\n            </div>\n        </div>\n        <div style=\"width: 48%; text-align: right;\">\n            <h4 style=\"margin: 0 0 5px 0;\">{{ doc.company }}</h4>\n            <div style=\"font-size: 13px; color: #4b5563;\">\n                {{ _(\"Date\") }}: {{ doc.transaction_date }}<br>\n                {{ _(\"Required By\") }}: {{ doc.schedule_date or \"\" }}\n            </div>\n        </div>\n    </div>\n\n    <!-- Items Table -->\n    <table class=\"table table-bordered\" style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n        <thead>\n            <tr style=\"background-color: #f3f4f6;\">\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: left;\">#</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: left;\">{{ _(\"Item\") }}</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ _(\"Qty\") }}</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ _(\"Rate\") }}</th>\n                <th style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ _(\"Amount\") }}</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db;\">{{ loop.index }}</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db;\">\n                    <b>{{ item.item_code }}</b><br>\n                    <small style=\"color: #6b7280;\">{{ item.item_name }}</small>\n                </td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ item.qty }} {{ item.uom or \"\" }}</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ frappe.format(item.rate, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ frappe.format(item.amount, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr style=\"background-color: #f9fafb; font-weight: bold;\">\n                <td colspan=\"4\" style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ _(\"Grand Total\") }} ({{ doc.currency }}):</td>\n                <td style=\"padding: 8px; border: 1px solid #d1d5db; text-align: right;\">{{ frappe.format(doc.grand_total, {\"fieldtype\": \"Currency\", \"currency\": doc.currency}) }}</td>\n            </tr>\n        </tfoot>\n    </table>\n</div>",
